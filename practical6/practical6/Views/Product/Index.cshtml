
@model practical6.Models.Product

<style>
    .product-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 30px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .product-header {
        font-size: 28px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 30px;
        text-align: center;
        border-bottom: 3px solid #3498db;
        padding-bottom: 15px;
    }

    .product-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 0;
        border-bottom: 1px solid rgba(52, 152, 219, 0.2);
        transition: background-color 0.3s ease;
    }

    .product-item:hover {
        background-color: rgba(255, 255, 255, 0.5);
        padding-left: 10px;
        border-radius: 6px;
    }

    .product-label {
        font-weight: 600;
        color: #34495e;
        min-width: 120px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .product-value {
        font-size: 16px;
        color: #2c3e50;
        font-weight: 500;
        flex: 1;
        text-align: right;
    }

    .price-highlight {
        font-size: 24px;
        color: #27ae60;
        font-weight: 700;
        background-color: rgba(39, 174, 96, 0.1);
        padding: 8px 12px;
        border-radius: 6px;
    }

    .category-badge {
        display: inline-block;
        background-color: #3498db;
        color: white;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .product-description {
        margin-top: 20px;
        padding: 15px;
        background-color: rgba(255, 255, 255, 0.7);
        border-left: 4px solid #3498db;
        border-radius: 4px;
        font-style: italic;
        color: #555;
        line-height: 1.6;
    }
</style>

<div class="product-container">
    <h1 class="product-header">New Product Info</h1>

    <div class="product-item">
        <span class="product-label">Product ID</span>
        <span class="product-value">@Model.Product_Id</span>
    </div>

    <div class="product-item">
        <span class="product-label">Product Name</span>
        <span class="product-value">@Model.Product_Name</span>
    </div>

    <div class="product-item">
        <span class="product-label">Category</span>
        <span class="product-value"><span class="category-badge">@Model.Product_Category</span></span>
    </div>

    <div class="product-item">
        <span class="product-label">Price</span>
        <span class="product-value price-highlight">@Model.Product_Price.ToString("N0")</span>
    </div>

    <div class="product-description">
        <strong>Description:</strong> @Model.Product_Desc
    </div>
</div>
                